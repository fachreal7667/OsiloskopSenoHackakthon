        plot_realtime(adc_data_2, sample_timestamps_2, spin_adc_ref2, "adc",
                      "WaveMind AI - Sinyal ADC ESP32 #2")
    root.after(100, update_esp32_2_plot)


def plot_realtime(raw_buffer, timestamps, scale_widget, scale_kind, title):
    """Plot real-time dengan skala tetap, jendela waktu, trigger dan posisi."""
    raw_values = list(raw_buffer)
    ts = list(timestamps)
    if len(raw_values) < 2 or len(ts) < 2:
        return
    n = min(len(raw_values), len(ts))
    raw_values, ts = raw_values[-n:], ts[-n:]
    time_data = [t - ts[0] for t in ts]
    t_latest = time_data[-1]
    scale_max = max(safe_float(scale_widget, 3.3), 0.001)
    # ESP32 #1 sends DAC codes; ESP32 #2 sends raw ADC codes.
    voltages = [(v / 4095.0) * scale_max for v in raw_values]
    time_div = max(safe_float(spin_time_div, 0.1), 0.001)
    x_span = time_div * 10.0
    hor_offset = safe_float(spin_hor_pos, 0.0)
    window_end = t_latest - hor_offset
    window_start = window_end - x_span
    trig_level = safe_float(spin_trig_level, 1.3)
    crossings = [i for i in range(1, n)
                 if voltages[i-1] < trig_level <= voltages[i]
                 and window_start <= time_data[i] <= window_end]
    if crossings and abs(hor_offset) < 1e-12:
        # Keep 20% of the screen before the most recent rising trigger edge.
        window_start = time_data[crossings[-1]] - 0.20 * x_span
        window_end = window_start + x_span
    indices = [i for i, t in enumerate(time_data) if window_start <= t <= window_end]
    ax.clear()
    volt_div = max(safe_float(spin_volt_div, 0.5), 0.001)
    ver_pos = safe_float(spin_ver_pos, 0.0)
    y_center = scale_max / 2.0
    y_min, y_max = y_center - 4.0 * volt_div, y_center + 4.0 * volt_div
    ax.set_ylim(y_min, y_max)
    ax.set_xlim(0.0, x_span)
    if indices:
        x_plot = [time_data[i] - window_start for i in indices]
        y_plot = [voltages[i] + ver_pos for i in indices]
        ax.plot(x_plot, y_plot, linewidth=1.2)
    ax.set_xticks([i * time_div for i in range(11)])
    ax.set_yticks([y_min + i * volt_div for i in range(9)])
    ax.axhline(trig_level + ver_pos, linestyle="--", linewidth=0.8, alpha=0.55)
    if indices:
        vmin, vmax = min(voltages[i] for i in indices), max(voltages[i] for i in indices)
        text_result.config(text=f"Vmin: {vmin:.3f} V    Vmax: {vmax:.3f} V    Vpp: {vmax-vmin:.3f} V\nTrigger: {trig_level:.2f} V    Sampel ditampilkan: {len(indices)}")
    ax.set_title(title)
    ax.set_xlabel("Waktu (detik)")
    ax.set_ylabel("Tegangan (V)")
    ax.grid(True, which="major", alpha=0.65)
    canvas.draw_idle()

# Jalankan pembaca ESP32 di thread terpisah
esp32_thread = threading.Thread(target=read_esp32, daemon=True)
esp32_thread.start()

# Jalankan pembaca ESP32 #2 di thread terpisah
