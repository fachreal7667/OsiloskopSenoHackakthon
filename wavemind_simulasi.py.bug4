    if mode.get() == "REAL-TIME":
        plot_realtime(adc_data, sample_timestamps, spin_adc_ref, "dac",
                      "WaveMind AI - Keluaran DAC ESP32 #1")
    after_id = root.after(100, update_esp32_plot)





# Fungsi pembaruan plot ESP32 #2
