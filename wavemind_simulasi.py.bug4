# Membaca data ADC dari ESP32
def read_esp32():
    """Baca ADC ESP32 #1; menerima angka saja atau format ADC:angka."""
    ser = None
    while True:
        try:
            if ser is None or not ser.is_open:
                ser = serial.Serial("COM7", 115200, timeout=1)
                time.sleep(2)
                ser.reset_input_buffer()
            line = ser.readline().decode("utf-8", errors="ignore").strip()
            if not line:
                continue
            try:
                raw_value = line.split(":", 1)[1] if line.startswith("ADC:") else line
                value = int(raw_value.strip())
                if 0 <= value <= 4095:
                    adc_data.append(value)
                    sample_timestamps.append(time.time())
                    sample_index.append(sample_index[-1] + 1 if sample_index else 0)
            except ValueError:
                pass  # Abaikan header/baris non-angka
        except (serial.SerialException, OSError):
            if ser is not None:
                try: ser.close()
                except Exception: pass
            ser = None
            time.sleep(2)


# Port serial tetap: generator ESP32 #1 = COM7, osiloskop ESP32 #2 = COM8.


def read_esp32_2():
    """Baca ADC ESP32 #2 dari COM pilihan; menerima angka saja atau ADC:angka."""
    ser = None
    active_port = None
    while True:
        try:
            selected_port = "COM8"
            if ser is None or not ser.is_open or selected_port != active_port:
                if ser is not None:
                    try: ser.close()
                    except Exception: pass
                ser = serial.Serial(selected_port, 115200, timeout=1)
                active_port = selected_port
                time.sleep(2)
                ser.reset_input_buffer()
            line = ser.readline().decode("utf-8", errors="ignore").strip()
            if not line:
                continue
            try:
                # Firmware pengguna mengirim angka ADC saja, misalnya 2048.
                raw_value = line.split(":", 1)[1] if line.startswith("ADC:") else line
                value = int(raw_value.strip())
                if 0 <= value <= 4095:
                    adc_data_2.append(value)
                    sample_timestamps_2.append(time.time())
                    sample_index_2.append(sample_index_2[-1] + 1 if sample_index_2 else 0)
            except ValueError:
                pass  # Abaikan header/baris non-angka
        except (serial.SerialException, OSError, ValueError):
            if ser is not None:
                try: ser.close()
                except Exception: pass
            ser = None
            active_port = None
            time.sleep(2)

