tk.Label(frame_input, text="Durasi (s):").grid(row=0, column=4)
entry_durasi = tk.Entry(frame_input, width=10)
entry_durasi.grid(row=0, column=5)
entry_durasi.insert(0, "2")

btn_generate = tk.Button(frame_input, text="Generate", command=on_generate)
btn_generate.grid(row=0, column=6, padx=5)

# Frame untuk grafik dan hasil
frame_display = tk.Frame(root)
frame_display.pack(fill=tk.BOTH, expand=True, padx=10, pady=10)

# Penampung sampel ADC dari ESP32
adc_data = deque(maxlen=500)
sample_index = deque(maxlen=500)

# Matplotlib figure ditanam di dalam Tkinter
fig = plt.Figure(figsize=(8, 4))
ax = fig.add_subplot(111)
ax.plot([], [])
canvas = FigureCanvasTkAgg(fig, master=frame_display)
canvas.get_tk_widget().pack(fill=tk.BOTH, expand=True)

# Membaca data ADC dari ESP32
def read_esp32():
    try:
        with serial.Serial("COM7", 115200, timeout=1) as ser:
            while True:
                line = ser.readline().decode(
                    "utf-8", errors="ignore"
                ).strip()

                if line.startswith("ADC:"):
                    try:
                        value = int(line.split(":")[1])
                        adc_data.append(value)
                        sample_index.append(
                            sample_index[-1] + 1
                            if sample_index else 0
                        )
                    except ValueError:
                        pass
    except serial.SerialException as e:
        print("Gagal membuka ESP32:", e)

# Text result
text_result = tk.Label(frame_display, text="", justify=tk.LEFT)
text_result.pack(side=tk.BOTTOM, fill=tk.X, pady=5)

# Tombol Generate pertama kali menunjukkan hasil default
on_generate()

# Memperbarui grafik dari data ESP32
def update_esp32_plot():
    if adc_data:
        ax.clear()
        ax.plot(list(sample_index), list(adc_data))
        ax.set_title("WaveMind AI - Sinyal ESP32")
        ax.set_xlabel("Sampel")
        ax.set_ylabel("Nilai ADC (0-4095)")
        ax.set_ylim(-100, 4200)
        ax.grid(True)
        canvas.draw_idle()

    root.after(100, update_esp32_plot)

# Jalankan pembaca ESP32 di thread terpisah
esp32_thread = threading.Thread(target=read_esp32, daemon=True)
esp32_thread.start()

# Mulai pembaruan grafik
update_esp32_plot()

# Jalankan aplikasi
root.mainloop()